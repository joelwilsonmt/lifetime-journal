# Owner of ./data on the host: run `id -u` and `id -g` as that user.
APP_UID=1000
APP_GID=1000

# Where to publish. Keep 127.0.0.1 and front it with `tailscale serve`
# (recommended, gives HTTPS), or set the server's Tailscale IP
# (`tailscale ip -4`) to reach it directly over the tailnet.
BIND_ADDR=127.0.0.1
# 3075 rather than 3000, which Gitea and others often use.
HOST_PORT=3075

# Days to keep cleared entries in data/.trash before pruning.
TRASH_DAYS=30

# Image to run. Published to GHCR by GitHub Actions on every push to main
# (`latest`, `sha-<commit>`) and on version tags (`1.2.3`, `1.2`). Pin VERSION
# to a release to control upgrades.
IMAGE=ghcr.io/joelwilsonmt/lifetime-journal
VERSION=latest
