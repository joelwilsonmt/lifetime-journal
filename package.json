{
  "name": "lifetime-journal",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:(client|server)$/\"",
    "dev:client": "vite",
    "dev:server": "PORT=3076 DATA_DIR=./data node --watch src/server/index.ts",
    "dev:demo": "node src/server/cli/seed-demo.ts && pnpm run --parallel \"/^demo:(client|server)$/\"",
    "demo:client": "API_PORT=3078 vite --port 3077",
    "demo:server": "PORT=3078 DATA_DIR=./demo-data node --watch src/server/index.ts",
    "demo:reset": "node src/server/cli/seed-demo.ts --reset",
    "build": "pnpm run build:client && pnpm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "import": "node src/server/cli/import.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "check": "biome check .",
    "format": "biome check --write .",
    "test:e2e": "pnpm build && playwright test",
    "screenshots": "node scripts/screenshots.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.14",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@fontsource/besley": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
